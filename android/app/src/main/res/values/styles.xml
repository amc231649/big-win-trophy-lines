<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/trophy_gold</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.26</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.App.Numeric" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/trophy_gold</item>
    </style>

    <style name="ShapeAppearance.App.Button" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/btn_primary_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:paddingStart">@dimen/spacing_l</item>
        <item name="android:paddingEnd">@dimen/spacing_l</item>
        <item name="backgroundTint">@color/award_red</item>
        <item name="rippleColor">@color/gold_ripple</item>
        <item name="strokeColor">@color/trophy_gold</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="elevation">8dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/trophy_gold_soft</item>
        <item name="iconPadding">@dimen/spacing_s</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/btn_secondary_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="backgroundTint">@color/navy_700</item>
        <item name="rippleColor">@color/light_stroke</item>
        <item name="strokeColor">@color/text_muted</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.App.Button.Floating" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="rippleColor">@color/gold_ripple</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconGravity">top</item>
        <item name="iconTint">@color/trophy_gold</item>
        <item name="iconPadding">@dimen/spacing_xs</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/gold_ripple</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/gold_stroke</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
    </style>

    <style name="Widget.App.Card.Stat" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/tile_radius</item>
        <item name="cardBackgroundColor">@color/navy_700</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/light_stroke</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
    </style>
</resources>
