<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/splash_mid"
                android:endColor="@color/splash_end"
                android:startColor="@color/navy_900"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/sprite_logo_emblem" />
    </item>
</layer-list>
