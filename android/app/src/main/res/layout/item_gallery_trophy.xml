<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gallery_cell_height"
    android:layout_margin="@dimen/spacing_xs"
    android:background="@drawable/gallery_slot"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_s">

    <ImageView
        android:id="@+id/gallery_sprite"
        android:layout_width="@dimen/sprite_node"
        android:layout_height="@dimen/sprite_node"
        android:layout_marginTop="@dimen/spacing_xs"
        android:contentDescription="@string/cd_trophy_slot"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/gallery_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/gallery_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textSize="9sp" />

</LinearLayout>
