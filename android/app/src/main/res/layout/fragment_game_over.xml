<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/over_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900">

    <ImageView
        android:id="@+id/over_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/over_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/over_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_l"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.bigwintrophy.lines.core.ui.SectionHeaderView
                android:id="@+id/over_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:appEyebrow="@string/over_eyebrow" />

            <FrameLayout
                android:id="@+id/over_hero_wrap"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/spacing_m">

                <View
                    android:id="@+id/over_burst"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.30"
                    android:background="@drawable/burst_gold"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/over_hero"
                    android:layout_width="@dimen/sprite_hero"
                    android:layout_height="@dimen/sprite_hero"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_hero_trophy"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_trophy_gold" />

            </FrameLayout>

            <TextView
                android:id="@+id/over_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:textAppearance="@style/TextAppearance.App.Display"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/over_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/over_result_card"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l">

                <LinearLayout
                    android:id="@+id/over_stats_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stat_tile_height"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_s">

                    <com.bigwintrophy.lines.core.ui.StatCardView
                        android:id="@+id/over_stat_pairs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:appAccent="@color/pair_mint"
                        app:appIcon="@drawable/sprite_medal_silver"
                        app:appIconDescription="@string/cd_trophy_slot"
                        app:appLabel="@string/over_stat_pairs" />

                    <com.bigwintrophy.lines.core.ui.StatCardView
                        android:id="@+id/over_stat_moves"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:appAccent="@color/line_azure"
                        app:appIcon="@drawable/sprite_cup_azure"
                        app:appIconDescription="@string/cd_play_icon"
                        app:appLabel="@string/over_stat_moves" />

                    <com.bigwintrophy.lines.core.ui.StatCardView
                        android:id="@+id/over_stat_points"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:appAccent="@color/trophy_gold"
                        app:appIcon="@drawable/sprite_trophy_gold"
                        app:appIconDescription="@string/cd_points_icon"
                        app:appLabel="@string/over_stat_points" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/over_play_again"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_primary_height"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/btn_play_again"
                app:icon="@drawable/ic_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/over_menu"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_secondary_height"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/btn_menu"
                app:icon="@drawable/ic_back" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
